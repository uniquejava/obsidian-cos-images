<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="obsidian-cos-images"
        Arguments=""
        InstallLocation="C:\Program Files\cyper\Obsidian COS Images">
    </Installer>
    <PackageInformation
        PackageName="Obsidian COS Images"
        PackageDisplayName="Obsidian COS Images"
        PublisherName="CN=cyper"
        PublisherDisplayName="cyper"
        Version="0.1.0.0"
        PackageDescription="Manage PicGo / Tencent COS images used by Obsidian Markdown notes">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.cyper.obsidiancosimages"
                Description="Manage PicGo / Tencent COS images used by Obsidian Markdown notes"
                DisplayName="Obsidian COS Images"
                ExecutableName="obsidian-cos-images"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Obsidian COS Images</DisplayName>
            <PublisherDisplayName>cyper</PublisherDisplayName>
            <Description>Manage PicGo / Tencent COS images used by Obsidian Markdown notes</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="obsidian-cos-images.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
