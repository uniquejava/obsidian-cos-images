# Copy to .env and fill in your values. Never commit .env.
#
# COS_BUCKET is typically "name-appid" (includes the numeric AppId suffix).
# COS_BASE_URL is the public/virtual-host style bucket URL for that region.

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_PREFIX=obsidian/
COS_BASE_URL=

# Comma-separated absolute paths to Obsidian vault roots (optional if set in Settings UI)
VAULT_PATHS=/Users/cyper/Library/Mobile Documents/iCloud~md~obsidian/Documents
