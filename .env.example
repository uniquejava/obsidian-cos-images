# Optional developer shortcut. Prefer Settings UI for packaged / normal use.
# Copy to .env and fill in your values. Never commit .env.
#
# Env values are used only when the corresponding field is empty in the
# OS user config file (Settings → Save).
#
# COS_BUCKET is typically "name-appid" (includes the numeric AppId suffix).
# COS_BASE_URL is the public/virtual-host style bucket URL for that region.

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_PREFIX=obsidian/
COS_BASE_URL=

# Comma-separated absolute paths (used only when no vault paths saved in Settings)
VAULT_PATHS=
